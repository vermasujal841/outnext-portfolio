# Copy this file to .env.local and fill in the values.

# The site's public domain, with https:// and no trailing slash.
# Used for canonical URLs, the sitemap, Open Graph tags and structured data.
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=https://gostuds.com

# Show clearly marked "Pending" slots for content that hasn't been provided yet.
# Set to "false" before launch to hide every unfilled slot.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Contact form delivery (https://resend.com). Leads are emailed to CONTACT_TO_EMAIL.
# Without these, the form shows a clear error in production and logs to the console in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@gostuds.com
# Must be an address on a domain verified in Resend, e.g. "Outnext Website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=
